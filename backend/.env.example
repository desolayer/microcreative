# Сервер
PORT=3000
NODE_ENV=development

# PostgreSQL
DATABASE_URL=postgresql://user:password@localhost:5432/microcreative

# Telegram Bot
TELEGRAM_BOT_TOKEN=your_bot_token_here

# CryptoBot (https://t.me/CryptoBot -> Crypto Pay API)
CRYPTOBOT_API_TOKEN=your_cryptobot_token
CRYPTOBOT_API_URL=https://pay.crypt.bot/api
# Для тестнета:
# CRYPTOBOT_API_URL=https://testnet-pay.crypt.bot/api

# Комиссия платформы (в процентах)
PLATFORM_COMMISSION=10

# URL вашего бэкенда (для вебхуков)
BACKEND_URL=https://your-domain.com
